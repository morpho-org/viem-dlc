{
  "name": "@morpho-org/viem-dlc",
  "version": "0.0.19",
  "description": "A collection of flexible viem extensions with a focus on intelligent caching.",
  "license": "MIT",
  "keywords": [
    "viem",
    "cache",
    "eth_getLogs",
    "deployless",
    "lens",
    "solidity"
  ],
  "author": "Morpho Association <contact@morpho.org>",
  "contributors": [
    "Hayden Shively <hayden@morpho.xyz>"
  ],
  "repository": "https://github.com/morpho-org/viem-dlc.git",
  "homepage": "https://github.com/morpho-org/viem-dlc",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./chains": {
      "types": "./dist/chains/index.d.ts",
      "import": "./dist/chains/index.js",
      "default": "./dist/chains/index.js"
    },
    "./solidity": {
      "types": "./dist/solidity/index.d.ts",
      "import": "./dist/solidity/index.js",
      "default": "./dist/solidity/index.js"
    },
    "./solidity/yul": {
      "types": "./dist/solidity/yul.d.ts",
      "import": "./dist/solidity/yul.js",
      "default": "./dist/solidity/yul.js"
    },
    "./solidity/build": {
      "types": "./dist/solidity/build/index.d.ts",
      "import": "./dist/solidity/build/index.js",
      "default": "./dist/solidity/build/index.js"
    },
    "./solidity/vite": {
      "types": "./dist/solidity/build/adapters/vite.d.ts",
      "import": "./dist/solidity/build/adapters/vite.js",
      "default": "./dist/solidity/build/adapters/vite.js"
    },
    "./solidity/next": {
      "types": "./dist/solidity/build/adapters/next.d.ts",
      "import": "./dist/solidity/build/adapters/next.js",
      "default": "./dist/solidity/build/adapters/next.js"
    },
    "./solidity/next/loader": {
      "types": "./dist/solidity/build/adapters/next-loader.d.cts",
      "require": "./dist/solidity/build/adapters/next-loader.cjs",
      "default": "./dist/solidity/build/adapters/next-loader.cjs"
    },
    "./solidity/register": {
      "types": "./dist/solidity/build/adapters/register.d.ts",
      "import": "./dist/solidity/build/adapters/register.js",
      "default": "./dist/solidity/build/adapters/register.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js",
      "default": "./dist/stores/index.js"
    },
    "./stores/upstash": {
      "types": "./dist/stores/upstash.d.ts",
      "import": "./dist/stores/upstash.js",
      "default": "./dist/stores/upstash.js"
    },
    "./stores/vercel": {
      "types": "./dist/stores/vercel.d.ts",
      "import": "./dist/stores/vercel.js",
      "default": "./dist/stores/vercel.js"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js",
      "default": "./dist/transports/index.js"
    },
    "./transports/cache": {
      "types": "./dist/transports/cache/index.d.ts",
      "import": "./dist/transports/cache/index.js",
      "default": "./dist/transports/cache/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/deployless": {
      "types": "./dist/utils/deployless/index.d.ts",
      "import": "./dist/utils/deployless/index.js",
      "default": "./dist/utils/deployless/index.js"
    }
  },
  "bin": {
    "viem-dlc-solidity": "./dist/solidity/build/adapters/cli.js"
  },
  "scripts": {
    "format": "pnpm exec biome format --write",
    "lint": "pnpm exec biome lint --write",
    "build": "tsc",
    "build:Envelope": "solc --optimize --optimize-runs=1 --strict-assembly --bin src/utils/deployless/Envelope.yul | awk '/Binary representation:/{getline;n=length($0)/2;sub(/62bbbbbb/,sprintf(\"62%06x\",n));print \"0x\"$0}'",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental && tsc --project test/solidity/tsconfig.json",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:forge": "forge test --root test/forge",
    "prepare": "pnpm build",
    "loc": "tokei src",
    "bench": "vitest bench --run",
    "bench:memory": "BENCH=1 vitest run test/bench/get-logs.memory.test.ts"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.0.0",
    "@vercel/blob": "^2.3.0",
    "oxc-parser": ">=0.152.0",
    "oxc-resolver": "^11.0.0",
    "solc": "^0.8.0",
    "viem": "^2.43.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "oxc-resolver": {
      "optional": true
    },
    "solc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "25.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "^2.6.1",
    "oxc-parser": "0.159.0",
    "oxc-resolver": "11.24.2",
    "solc": "0.8.36",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "viem": "2.57.5",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.20.0"
}
