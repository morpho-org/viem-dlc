{
  "name": "@morpho-org/viem-dlc",
  "version": "0.0.16",
  "description": "A collection of flexible viem extensions with a focus on intelligent caching.",
  "license": "MIT",
  "keywords": [
    "viem",
    "cache",
    "eth_getLogs"
  ],
  "author": "Morpho Association <contact@morpho.org>",
  "contributors": [
    "Hayden Shively <hayden@morpho.xyz>"
  ],
  "repository": "https://github.com/morpho-org/viem-dlc.git",
  "homepage": "https://github.com/morpho-org/viem-dlc",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js",
      "default": "./dist/stores/index.js"
    },
    "./stores/upstash": {
      "types": "./dist/stores/upstash.d.ts",
      "import": "./dist/stores/upstash.js",
      "default": "./dist/stores/upstash.js"
    },
    "./stores/vercel": {
      "types": "./dist/stores/vercel.d.ts",
      "import": "./dist/stores/vercel.js",
      "default": "./dist/stores/vercel.js"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js",
      "default": "./dist/transports/index.js"
    },
    "./transports/cache": {
      "types": "./dist/transports/cache/index.d.ts",
      "import": "./dist/transports/cache/index.js",
      "default": "./dist/transports/cache/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "format": "pnpm exec biome format --write",
    "lint": "pnpm exec biome lint --write",
    "build": "tsc",
    "build:RevertEnvelope": "solc --optimize --optimize-runs=1 --strict-assembly --bin src/utils/deployless/RevertEnvelope.yul | awk '/Binary representation:/{getline;n=length($0)/2;sub(/62bbbbbb/,sprintf(\"62%06x\",n));print \"0x\"$0}'",
    "build:RevertEnvelopeCompressed": "solc --optimize --optimize-runs=1 --strict-assembly --bin src/utils/deployless/RevertEnvelopeCompressed.yul | awk '/Binary representation:/{getline;n=length($0)/2;sub(/62bbbbbb/,sprintf(\"62%06x\",n));print \"0x\"$0}'",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental",
    "pretest": "pnpm build",
    "test": "vitest run",
    "prepare": "pnpm build",
    "loc": "tokei src"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.0.0",
    "@vercel/blob": "^2.3.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "25.2.0",
    "@upstash/redis": "1.38.1",
    "@vercel/blob": "^2.6.1",
    "loglayer": "^9.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "viem": "2.55.10",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
