{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "..",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@morpho-org/viem-dlc": ["../src/index.ts"],
      "@morpho-org/viem-dlc/*": ["../src/*/index.ts"]
    },
    "plugins": [{ "name": "soltag/plugin" }]
  },
  "include": ["./**/*.ts", "./**/*.js", "./.soltag/types.d.ts"],
  "exclude": ["dist", "public", "node_modules"]
}
